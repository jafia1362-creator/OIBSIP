PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pizza_delivery
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Nodemailer Credentials (Update with your credentials)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Razorpay Test Credentials (Update with your Razorpay Test Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Admin Alert Threshold
LOW_STOCK_THRESHOLD=20
ADMIN_EMAIL=admin@pizzadelivery.com
